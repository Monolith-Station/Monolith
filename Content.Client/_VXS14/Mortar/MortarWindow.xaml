<controls:MortarWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._VXS14.Mortar">
    <BoxContainer Orientation="Vertical">
        <Label Text="Mortar Control" />
        <BoxContainer Orientation="Horizontal">
            <Label Text="Offset X:" />
            <LineEdit Name="OffsetX" Text="5" MinWidth="80" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Label Text="Offset Y:" />
            <LineEdit Name="OffsetY" Text="0" MinWidth="80" />
        </BoxContainer>
        <Button Name="Recentre" Text="Recentre" />
        <Button Name="Spawn" Text="Set Target" />
    </BoxContainer>
</controls:MortarWindow>
