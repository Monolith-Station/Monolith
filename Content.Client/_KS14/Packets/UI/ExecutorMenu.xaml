<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    SetSize="1650, 635"
    Title="{Loc 'executor-menu-title'}">
    <TabContainer Name="ExecutorTabs" Access="Public">
        <PanelContainer Name="Executor">
            <PanelContainer Name="CodeControl" SetSize="230, 550" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
                <PanelContainer Name="Buttons" SetSize="200, 50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="15, 0, 0, 125">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#090909" />
                    </PanelContainer.PanelOverride>
                    <Button Name="ExecuteButton" SetSize="60, 30" Margin="5 0 0 0" TextAlign="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Text="EXEC"></Button>
                    <Button Name="LoadButton" SetSize="60, 30" Margin="0 0 5 0" TextAlign="Center" HorizontalAlignment="Right" VerticalAlignment="Center" Text="UPDT"></Button>
                    <Button Name="TerminateButton" SetSize="60, 30" Text="KILL" TextAlign="Center" HorizontalAlignment="Center" VerticalAlignment="Center"></Button>
                </PanelContainer>
                <PanelContainer Name="Data"
                                SetSize="200, 350"
                                VerticalAlignment="Top"
                                Margin="5 0 0 0">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#090909" />
                    </PanelContainer.PanelOverride>
                    <Label Name="DataLabel" VerticalAlignment="Top"></Label>
                </PanelContainer>
            </PanelContainer>
            <PanelContainer Name="CodeInput"
                            SetSize="700, 550"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="-355 10 0 0">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#090909" />
                </PanelContainer.PanelOverride>
                <TextEdit Name="Input" Access="Public" Margin="10, 10, 10, 10"/>
            </PanelContainer>
            <PanelContainer Name="CodeOutput"
                            SetSize="350, 550"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="15 10 285 0"
                            >
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#090909" />
                </PanelContainer.PanelOverride>
                <TextEdit Editable="False" Name="ExecutorLog" Access="Public" Margin="10, 10, 10, 10"/>
            </PanelContainer>
            <PanelContainer Name="DefinitionsPanel"
                            SetSize="250, 550"
                            Margin="15 10 15 0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            >
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#090909" />
            </PanelContainer.PanelOverride>
                <Label VerticalAlignment="Top"
                       HorizontalAlignment="Center"/>
                <TextEdit Name="Definitions"
                          Access="Public"
                          Editable="False"/>
            </PanelContainer>
        </PanelContainer>
    </TabContainer>
</controls:FancyWindow>
