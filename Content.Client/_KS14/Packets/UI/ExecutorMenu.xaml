<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    SetSize="1350, 680"
    Title="{Loc 'executor-menu-title'}">
    <PanelContainer Name="CodeControl" SetSize="250, 550" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
        <PanelContainer Name="Buttons" SetSize="200, 65" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="15 10 0 100">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1a1a1a" />
            </PanelContainer.PanelOverride>
            <Button Name="ExecuteButton" SetSize="60, 30" Margin="5 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="EXEC"></Button>
            <Button Name="SaveButton" SetSize="60, 30" Text="SAVE" VerticalAlignment="Top"></Button>
            <Button Name="LoadButton" SetSize="60, 30" Margin="0 0 5 0" HorizontalAlignment="Right" VerticalAlignment="Top" Text="UPDT"></Button>
            <Button Name="TerminateButton" SetSize="60, 30" Text="KILL" Margin="5 0 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Left"></Button>
            <Button Name="SendInputButton" SetSize="60, 30" Text="SEND" Margin="0 0 5 0" VerticalAlignment="Bottom" HorizontalAlignment="Right"></Button>
        </PanelContainer>
        <PanelContainer Name="Data" SetSize="200, 350" VerticalAlignment="Top" Margin="-15 0 0 0">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1a1a1a" />
            </PanelContainer.PanelOverride>
            <Label Name="DataLabel" VerticalAlignment="Top"></Label>
        </PanelContainer>
    </PanelContainer>
    <PanelContainer Name="CodeInput" SetSize="700, 550" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-150 10 0 0">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#000000" />
        </PanelContainer.PanelOverride>
        <PanelContainer SetSize="700, 550" Name="InputContainer">
            <TextEdit Name="Input" Access="Public" />
        </PanelContainer>
    </PanelContainer>
    <PanelContainer Name="CodeOutput" SetSize="350, 550" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15 10 15 0">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#000000" />
        </PanelContainer.PanelOverride>
        <PanelContainer SetSize="350, 550" Name="OutputContainer">
            <Label Name="ExecutorLog" Text="" ClipText="True" VerticalAlignment="Top" Access="Public"></Label>
        </PanelContainer>
    </PanelContainer>
    <PanelContainer Name="StandartInput" SetSize="1085, 60" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15 10 15 10">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#000000" />
        </PanelContainer.PanelOverride>
        <PanelContainer SetSize="1085, 60" Name="StandartInputContainer">
            <TextEdit Name="DataInput" Access="Public" />
        </PanelContainer>
    </PanelContainer>
</controls:FancyWindow>
