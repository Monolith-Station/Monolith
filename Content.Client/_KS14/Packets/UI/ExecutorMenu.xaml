<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    SetSize="1650, 780"
    Title="{Loc 'executor-menu-title'}">
    <TabContainer Name="ExecutorTabs" Access="Public">
        <PanelContainer Name="Executor" StyleIdentifier="executorBorderless">
            <PanelContainer Name="CodeControl" SetSize="230, 550" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" StyleIdentifier="executor">
                <PanelContainer Name="Buttons" SetSize="200, 100" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="1 0 0 70" StyleIdentifier="executor">
                    <Button Name="ExecuteButton" SetSize="60, 30" Margin="5 0 0 0" TextAlign="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Text="EXEC" StyleIdentifier="executor"></Button>
                    <Button Name="LoadButton" SetSize="60, 30" Margin="0 0 5 0" TextAlign="Center" HorizontalAlignment="Right" VerticalAlignment="Top" Text="UPDT" StyleIdentifier="executor"></Button>
                    <Button Name="TerminateButton" SetSize="60, 30" Text="KILL" TextAlign="Center" Margin="5 0 0 0" VerticalAlignment="Bottom" HorizontalAlignment="Left" StyleIdentifier="executor"></Button>
                </PanelContainer>
                <PanelContainer Name="Data"
                                SetSize="200, 350"
                                VerticalAlignment="Top"
                                Margin="5 0 0 0"
                                StyleIdentifier="executor">
                    <Label Name="DataLabel" VerticalAlignment="Top" StyleIdentifier="executor"></Label>
                </PanelContainer>
            </PanelContainer>
            <PanelContainer Name="CodeInput"
                            SetSize="700, 550"
                            HorizontalAlignment="Center"
                            StyleIdentifier="executorBlue"
                            VerticalAlignment="Top"
                            Margin="-355 10 0 0">
                <TextEdit Name="Input" Access="Public" Margin="10, 10, 10, 10" StyleIdentifier="executorBlue"/>
            </PanelContainer>
            <PanelContainer Name="CodeOutput"
                            SetSize="350, 550"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="15 10 285 0"
                            StyleIdentifier="executorBlue">
                <TextEdit Editable="False" Name="ExecutorLog" Access="Public" Margin="10, 10, 10, 10" StyleIdentifier="executorBlue"/>
            </PanelContainer>
            <PanelContainer Name="DefinitionsPanel"
                            SetSize="250, 550"
                            Margin="15 10 15 0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            StyleIdentifier="executor">
                <Label StyleIdentifier="executor"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"/>
                <TextEdit Name="Definitions"
                          Access="Public"
                          StyleIdentifier="executor"
                          Editable="False"/>
            </PanelContainer>
        </PanelContainer>
    </TabContainer>
</controls:FancyWindow>
