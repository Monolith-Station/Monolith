<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:ui="clr-namespace:Content.Client._Forge.ShipyardService.UI"
                      Title="{Loc 'shipyard-service-grid-window-title'}"
                      SetSize="780 720"
                      MinSize="640 560">
    <BoxContainer Orientation="Vertical" Margin="8">
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 6">
            <CheckBox Name="RepairCheck" Text="{Loc 'shipyard-service-grid-filter-repair'}" Pressed="True" />
            <CheckBox Name="ReinforceCheck" Text="{Loc 'shipyard-service-grid-filter-reinforce'}" Pressed="True" Margin="12 0 0 0" />
            <CheckBox Name="PlastitaniumCheck" Text="{Loc 'shipyard-service-grid-filter-plastitanium'}" Pressed="True" Margin="12 0 0 0" />
            <CheckBox Name="PartsCheck" Text="{Loc 'shipyard-service-grid-filter-parts'}" Pressed="True" Margin="12 0 0 0" />
        </BoxContainer>
        <RichTextLabel Name="HintLabel" Margin="0 0 0 6" />
        <ui:ShipyardServiceGridControl Name="GridMap" HorizontalExpand="True" VerticalExpand="True" />
        <BoxContainer Orientation="Horizontal" Margin="0 8 0 0">
            <Button Name="SelectAllButton" Text="{Loc 'shipyard-service-grid-select-all'}" />
            <Button Name="ClearButton" Text="{Loc 'shipyard-service-grid-clear'}" Margin="8 0 0 0" />
            <Control HorizontalExpand="True" />
            <RichTextLabel Name="SelectionLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 8 0" />
            <Button Name="ApplyButton" Text="{Loc 'shipyard-service-grid-apply'}" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
