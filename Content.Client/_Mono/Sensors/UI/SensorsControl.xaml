<BoxContainer xmlns="https://spacestation14.io"
              xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
              xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
              Orientation="Vertical"
              HorizontalExpand="True"
              VerticalExpand="True"
              Margin="6">

    <controls:StripeBack MinSize="36 36">
        <Label Text="{Loc 'gunnery-emcon-sensors'}" HorizontalAlignment="Left" StyleClasses="StatusFieldTitle"/>
    </controls:StripeBack>

    <PanelContainer VerticalExpand="False" MinHeight="140">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#000000"/>
        </PanelContainer.PanelOverride>
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="HardwareBox" Orientation="Vertical" Margin="4"/>
        </ScrollContainer>
    </PanelContainer>

    <controls:StripeBack MinSize="36 36" Margin="0 8 0 0">
        <Label Text="{Loc 'gunnery-emcon-contacts'}" HorizontalAlignment="Left" StyleClasses="StatusFieldTitle"/>
    </controls:StripeBack>

    <BoxContainer Orientation="Horizontal" Margin="4 2">
        <Label Text="{Loc 'gunnery-emcon-range'}" MinWidth="80" StyleClasses="LabelKeyText" HorizontalAlignment="Left"/>
        <Label Text="{Loc 'gunnery-emcon-angle'}" MinWidth="80" StyleClasses="LabelKeyText" HorizontalAlignment="Left"/>
        <Label Text="{Loc 'gunnery-emcon-source'}" MinWidth="110" StyleClasses="LabelKeyText" HorizontalAlignment="Left"/>
        <Label Text="{Loc 'gunnery-emcon-cross-section'}" MinWidth="110" StyleClasses="LabelKeyText" HorizontalAlignment="Left"/>
        <Label Text="{Loc 'gunnery-emcon-infrared'}" MinWidth="120" StyleClasses="LabelKeyText" HorizontalAlignment="Left"/>
        <Label Text="{Loc 'gunnery-emcon-ars'}" MinWidth="110" StyleClasses="LabelKeyText" HorizontalAlignment="Left"/>
        <Label Text="{Loc 'gunnery-emcon-track'}" HorizontalExpand="True" StyleClasses="LabelKeyText" HorizontalAlignment="Left"/>
    </BoxContainer>

    <PanelContainer VerticalExpand="True">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#000000"/>
        </PanelContainer.PanelOverride>
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="ContactsBox" Orientation="Vertical" Margin="4"/>
        </ScrollContainer>
    </PanelContainer>

    <controls:StripeBack MinSize="32 32" Margin="0 8 0 0">
        <Label Text="{Loc 'gunnery-emcon-datalink'}" HorizontalAlignment="Left" StyleClasses="StatusFieldTitle"/>
    </controls:StripeBack>
    <BoxContainer Orientation="Horizontal" Margin="2">
        <LineEdit Name="DatalinkEdit" HorizontalExpand="True" PlaceHolder="{Loc 'gunnery-emcon-datalink-placeholder'}"/>
        <Button Name="DatalinkApply" Text="Set" MinWidth="64"/>
    </BoxContainer>
</BoxContainer>
