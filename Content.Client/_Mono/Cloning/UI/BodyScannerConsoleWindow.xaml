<DefaultWindow xmlns="https://spacestation14.io"
            Title="{Loc 'body-scanner-console-window-title'}"
            SetSize="400 220"
            MinSize="400 220">
    <PanelContainer VerticalExpand="True" StyleClasses="Inset">
        <BoxContainer Margin="5 5 5 5" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
            <Label HorizontalAlignment="Center" Text="{Loc 'body-scanner-console-window-scanner-label'}" />
            <Label Name="OccupantLabel" HorizontalAlignment="Center" />
            <Control MinSize="0 5" />
            <Label Name="StatusLabel" HorizontalAlignment="Center" />
            <Control MinSize="0 5" />
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Name="DatabaseLabel" VerticalAlignment="Center" Margin="0 0 5 0" />
                <Button Name="DatabaseButton" Access="Public" Text="{Loc 'genetic-database-select-button'}" />
            </BoxContainer>
            <Control VerticalExpand="True" />
            <Button Name="ScanButton"
                    Access="Public"
                    Text="{Loc 'body-scanner-console-window-scan-button'}"
                    HorizontalAlignment="Center" />
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
