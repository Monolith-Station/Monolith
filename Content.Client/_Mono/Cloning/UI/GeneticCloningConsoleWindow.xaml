<DefaultWindow xmlns="https://spacestation14.io"
            xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
            xmlns:system="clr-namespace:System;assembly=System.Runtime"
            Title="{Loc 'cloning-console-window-title'}"
            SetSize="650 520"
            MinSize="600 450">
    <BoxContainer Orientation="Vertical"
                  VerticalExpand="True"
                  HorizontalExpand="True">
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 5">
            <Label Name="DatabaseLabel" VerticalAlignment="Center" Margin="0 0 5 0" />
            <Button Name="DatabaseButton" Access="Public" Text="{Loc 'genetic-database-select-button'}" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True">
            <PanelContainer VerticalExpand="True" HorizontalExpand="True" StyleClasses="Inset">
                <BoxContainer Margin="5 5 5 5" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                    <LineEdit Name="SearchBar"
                              PlaceHolder="{Loc 'cloning-console-window-search-placeholder'}"
                              HorizontalExpand="True"
                              Margin="0 0 0 5" />
                    <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                        <BoxContainer Name="RecordList" Orientation="Vertical" HorizontalExpand="True" />
                    </ScrollContainer>
                    <Label Name="NoRecordsLabel"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           VerticalExpand="True"
                           Text="{Loc 'cloning-console-window-no-records'}" />
                </BoxContainer>
            </PanelContainer>
            <Control MinSize="5 0" />
            <PanelContainer VerticalExpand="True" HorizontalExpand="True" StyleClasses="Inset">
                <BoxContainer Name="RecordDetails" Margin="5 5 5 5" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                    <Label Name="RecordNameLabel" StyleClasses="LabelHeading" />
                    <Label Name="RecordSpeciesLabel" />
                    <Label Name="RecordScannedLabel" />
                    <Control MinSize="0 5" />
                    <RichTextLabel Name="RecordStatusLabel" HorizontalExpand="True" />
                    <Control VerticalExpand="True" />
                    <Label Name="CloningActivity"
                           HorizontalAlignment="Center"
                           HorizontalExpand="True" />
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5 0 0">
                        <Button Name="CloneButton"
                                Access="Public"
                                Text="{Loc 'cloning-console-window-clone-button-text'}"
                                Margin="0 0 5 0" />
                        <controls:ConfirmButton Name="DeleteButton"
                                                Access="Public"
                                                Text="{Loc 'cloning-console-window-delete-button-text'}"
                                                ConfirmationText="{Loc 'cloning-console-window-delete-confirm-text'}">
                            <Button.StyleClasses>
                                <system:String>ButtonColorRed</system:String>
                            </Button.StyleClasses>
                        </controls:ConfirmButton>
                    </BoxContainer>
                </BoxContainer>
                <Label Name="NoSelectionLabel"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{Loc 'cloning-console-window-no-selection'}" />
            </PanelContainer>
        </BoxContainer>
        <Control MinSize="50 5" />
        <PanelContainer MinSize="0 90" StyleClasses="Inset">
            <BoxContainer Name="CloningPodContents" Margin="5 5 5 5" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                <Label HorizontalAlignment="Center" Text="{Loc 'cloning-console-window-pod-details-label'}" />
                <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                    <RichTextLabel Name="ClonerInfoLabel"
                            Access="Public"
                            HorizontalExpand="True" />
                    <RichTextLabel Name="ClonerBrainActivity"
                            Access="Public"
                            HorizontalExpand="True"/>
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Name="CloningPodMissing" Margin="5 5 5 5" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                <Label HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Loc 'cloning-console-window-no-clone-pod-detected-label'}" />
            </BoxContainer>
            <BoxContainer Name="CloningPodFar" Margin="5 5 5 5" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                <Label HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Loc 'cloning-console-window-clone-pod-far-label'}" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
