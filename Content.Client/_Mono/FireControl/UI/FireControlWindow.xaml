<controls:FancyWindow xmlns="https://spacestation14.io"
            xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
            xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
            xmlns:ui="clr-namespace:Content.Client._Mono.FireControl.UI"
            xmlns:sensors="clr-namespace:Content.Client._Mono.Sensors.UI"
            Title="{Loc 'gunnery-window-title'}" SetSize="1000 870" MinSize="1000 870">
    <BoxContainer Orientation="Vertical">
        <!-- Outer chrome (same as shuttle) -->
        <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="0 8 0 2">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BorderThickness="7" BorderColor="#252525" BackgroundColor="#3d474d"/>
            </PanelContainer.PanelOverride>
            <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="4">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BorderThickness="2" BorderColor="#333333" BackgroundColor="#181818"/>
                </PanelContainer.PanelOverride>

                <BoxContainer Orientation="Vertical" HorizontalAlignment="Center" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" HorizontalAlignment="Center">
                    <!-- Mode buttons row (identical style to shuttle) -->
                    <PanelContainer VerticalExpand="False" HorizontalExpand="True" SetWidth="970">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BorderThickness="2" BorderColor="#333333" BackgroundColor="#121212"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Name="ModeButtons" Orientation="Horizontal"
                                      HorizontalExpand="True" MinSize="52 52" Margin="5">
                            <Button Name="GunneryModeButton" ToggleMode="True"
                                    HorizontalExpand="True" VerticalExpand="True"
                                    Text="GUNNERY" StyleClasses="ButtonSquare"/>
                            <Button Name="SensorsModeButton" ToggleMode="True"
                                    HorizontalExpand="True" VerticalExpand="True"
                                    Text="SENSORS" StyleClasses="ButtonSquare"/>
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>

                <LayoutContainer VerticalExpand="True">
                <BoxContainer Name="Contents" HorizontalExpand="True" VerticalExpand="True" Margin="5">
                    <BoxContainer Name="RootBox" Orientation="Horizontal">
                        <BoxContainer Name="GunneryContainer" Orientation="Horizontal" Visible="True">
                    <BoxContainer Orientation="Vertical" MinWidth="300" MaxWidth="300" HorizontalExpand="False" Margin="5 0 5 5">
                    <PanelContainer VerticalExpand="True" HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BorderThickness="3" BorderColor="#35434d" BackgroundColor="#696969"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" MinWidth="290" MaxWidth="290" HorizontalExpand="False" Margin="0 2.5 0 2.5">
                            <PanelContainer VerticalExpand="True" HorizontalExpand="True">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BorderThickness="3" BorderColor="#1f1f1f" BackgroundColor="#1f1f1f"/>
                                </PanelContainer.PanelOverride>
                                <BoxContainer Name="ControlsBox" Orientation="Vertical" MinWidth="285" MaxWidth="285" HorizontalExpand="False" Margin="0 0 0 0">
                                    <controls:StripeBack MinSize="48 48">
                                        <Label Name="ServerStatus" Text="{Loc 'gunnery-window-disconnected'}"
                                               StyleClasses="LabelKeyText" HorizontalAlignment="Center"/>
                                    </controls:StripeBack>
                                    <PanelContainer VerticalExpand="False" HorizontalExpand="True">
                                        <PanelContainer.PanelOverride>
                                            <gfx:StyleBoxFlat BorderThickness="4" BorderColor="#2e2e2e" BackgroundColor="#1c1c1c" />
                                        </PanelContainer.PanelOverride>
                                        <BoxContainer Orientation="Vertical">
                                        <Button Name="RefreshButton" Access="Public" Text="{Loc admin-logs-refresh}"
                                                StyleClasses="ButtonSquare" Margin="2 2 2 2"/>
                                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                                        <Button Name="RadarTrackToggle" Access="Public" Text="{Loc gunnery-sarh}"
                                                StyleClasses="ButtonSquare" Margin="2 2 2 2" ToggleMode="True" HorizontalExpand="True"/>
                                        <Button Name="LockModeToggle" Access="Public" Text="{Loc gunnery-lock}"
                                                StyleClasses="ButtonSquare" Margin="2 2 2 2" ToggleMode="True" HorizontalExpand="True"/>
                                        </BoxContainer>
                                        </BoxContainer>
                                    </PanelContainer>

                                    <controls:StripeBack MinSize="48 48" Margin="0 0 0 0">
                                        <Label Name="WeaponsLabel" Text="{Loc 'gunnery-guns'}" HorizontalAlignment="Center" StyleClasses="StatusFieldTitle"/>
                                    </controls:StripeBack>
                                    <BoxContainer Orientation="Horizontal" Margin="0 0">
                                        <Button Name="SelectAllButton" Access="Public" Text="{Loc 'gunnery-select-all'}"
                                                StyleClasses="OpenRight" HorizontalExpand="True"/>
                                        <Button Name="UnselectAllButton" Access="Public" Text="{Loc 'gunnery-unselect-all'}"
                                                StyleClasses="OpenLeft" HorizontalExpand="True"/>
                                    </BoxContainer>
                                    <PanelContainer VerticalExpand="False" HorizontalExpand="True">
                                        <PanelContainer.PanelOverride>
                                            <gfx:StyleBoxFlat BorderThickness="4" BorderColor="#262626" BackgroundColor="#111111" />
                                        </PanelContainer.PanelOverride>
                                        <BoxContainer Orientation="Vertical" MinWidth="256" MaxWidth="256" HorizontalExpand="False" Margin="2 3 2 3">
                                            <PanelContainer VerticalExpand="False" HorizontalExpand="True">
                                                <PanelContainer.PanelOverride>
                                                    <gfx:StyleBoxFlat BorderThickness="4" BorderColor="#2e2e2e" BackgroundColor="#1c1c1c" />
                                                </PanelContainer.PanelOverride>
                                                <Button Name="SelectBallisticButton" Access="Public" Text="Ballistics"
                                                        StyleClasses="ButtonSquare" HorizontalExpand="True" Margin="4 4"/>
                                            </PanelContainer>
                                            <PanelContainer VerticalExpand="False" HorizontalExpand="True">
                                                <PanelContainer.PanelOverride>
                                                    <gfx:StyleBoxFlat BorderThickness="4" BorderColor="#2e2e2e" BackgroundColor="#1c1c1c" />
                                                </PanelContainer.PanelOverride>
                                                <Button Name="SelectEnergyButton" Access="Public" Text="Energy"
                                                        StyleClasses="ButtonSquare" HorizontalExpand="True" Margin="4 4"/>
                                            </PanelContainer>
                                            <PanelContainer VerticalExpand="False" HorizontalExpand="True">
                                                <PanelContainer.PanelOverride>
                                                    <gfx:StyleBoxFlat BorderThickness="4" BorderColor="#2e2e2e" BackgroundColor="#1c1c1c" />
                                                </PanelContainer.PanelOverride>
                                                <Button Name="SelectMissileButton" Access="Public" Text="Missiles"
                                                        StyleClasses="ButtonSquare" HorizontalExpand="True" Margin="4 4"/>
                                            </PanelContainer>
                                        </BoxContainer>
                                    </PanelContainer>
                                    <PanelContainer VerticalExpand="False" HorizontalExpand="True">
                                        <PanelContainer.PanelOverride>
                                            <gfx:StyleBoxFlat BorderThickness="4" BorderColor="#262626" BackgroundColor="#111111" />
                                        </PanelContainer.PanelOverride>
                                        <PanelContainer VerticalExpand="False" HorizontalExpand="True">
                                            <PanelContainer.PanelOverride>
                                                <gfx:StyleBoxFlat BorderThickness="4" BorderColor="#2e2e2e" BackgroundColor="#1c1c1c" />
                                            </PanelContainer.PanelOverride>
                                        <BoxContainer Orientation="Horizontal" MinWidth="256" MaxWidth="256" HorizontalExpand="False" Margin="2 3 2 3">
                                                <Button Name="IFFToggle" Access="Public" Text="{Loc 'shuttle-console-iff-toggle-short'}"
                                                        StyleClasses="ButtonSquare" HorizontalExpand="True" Margin="4 4" ToggleMode="True"/>
                                                <Button Name="IFFDetailedToggle" Access="Public" Text="{Loc 'shuttle-console-iff-detailed-short'}"
                                                        StyleClasses="ButtonSquare" HorizontalExpand="True" Margin="4 4" ToggleMode="True"/>
                                                <Button Name="DockToggle" Access="Public" Text="{Loc 'shuttle-console-dock-toggle-short'}"
                                                        StyleClasses="ButtonSquare" HorizontalExpand="True" Margin="4 4" ToggleMode="True"/>
                                                <Button Name="MarkersToggle" Access="Public" Text="{Loc 'shuttle-console-markers-toggle-short'}"
                                                        StyleClasses="ButtonSquare" HorizontalExpand="True" Margin="4 4" ToggleMode="True"/>
                                        </BoxContainer>
                                    </PanelContainer>
                                    </PanelContainer>

                                    <PanelContainer VerticalExpand="True" Margin="0 3 0 3">
                                        <PanelContainer.PanelOverride>
                                            <gfx:StyleBoxFlat BackgroundColor="#111111" />
                                        </PanelContainer.PanelOverride>
                                        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                                            <BoxContainer Name="ControllablesBox" Orientation="Vertical"
                                                         HorizontalExpand="True" StyleClasses="transparentItemList"/>
                                        </ScrollContainer>
                                    </PanelContainer>
                                </BoxContainer>
                            </PanelContainer>
                        </BoxContainer>
                    </PanelContainer>
                    </BoxContainer>

                    <BoxContainer Name="RadarContainer" Orientation="Horizontal" HorizontalExpand="True" Margin="50 50 50 50">
                        <LayoutContainer>
                            <ui:FireControlNavControl Name="NavRadar" />
                        </LayoutContainer>
                    </BoxContainer>
                    </BoxContainer>
                        </BoxContainer>
                </BoxContainer>
                </LayoutContainer>
                </BoxContainer>
                <sensors:SensorsControl Name="SensorsTab" Access="Public" VerticalExpand="True" Margin="5 80 5 5"/>
            </PanelContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
