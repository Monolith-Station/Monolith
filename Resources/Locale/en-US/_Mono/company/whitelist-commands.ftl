cmd-companywhitelistget-desc = Gets all the companies that a player has been whitelisted for.
cmd-companywhitelistget-help = Usage: companywhitelistget <username>
cmd-companywhitelistget-whitelisted-none = Player {$player} is not whitelisted for any companies.
cmd-companywhitelistget-whitelisted-for = Player {$player} is whitelisted for:
{$companies}

cmd-companywhitelistremove-desc = Removes a player's ability to play a whitelisted company.
cmd-companywhitelistremove-help = Usage: companywhitelistremove <username> <company>
cmd-companywhitelistremove-was-not-whitelisted = {$player} was not whitelisted to play as {$companyId} ({$companyName}).
cmd-companywhitelistremove-removed = Removed {$player} from the whitelist for {$companyId} ({$companyName}).
