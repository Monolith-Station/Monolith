mass-fabricator-chip-slot-1 = Blueprint slot 1
mass-fabricator-chip-slot-2 = Blueprint slot 2
mass-fabricator-chip-slot-3 = Blueprint slot 3
mass-fabricator-print-denied = This plan cannot be printed.
mass-fabricator-print-indirect = This plan can't be printed directly.
mass-fabricator-unsupported-tile =
    There isn't enough support below for this plan.
    Add a wall or support pillar below.
mass-fabricator-wave-arrow =
    This plan relies on support from other blueprints.
    Start fabrication from the tile being pointed to.
mass-fabricator-no-wave-start =
    This plan relies on support from other blueprints.
    Earlier blueprints this is connected to need to be printed first.
mass-fabricator-blueprint-removed =
    The relevant blueprint for this plan isn't loaded.
    Re-insert the blueprint chip to print this.
mass-fabricator-display-name = { CAPITALIZE($name) }
mass-fabricator-materials-title = Materials
mass-fabricator-buffer-hint = Right-click to view materials.
mass-fabricator-buffer-total = { $stored } / { $capacity } units
mass-fabricator-buffer-unlimited = unlimited
mass-fabricator-examine-load = [bold]Blueprint load:[/bold] { $current } / { $maximum } [color={ $color }]({ $percent }%)[/color]
mass-fabricator-examine-buffer = [bold]Material buffer:[/bold] { $stored } / { $capacity } units
mass-fabricator-examine-material = [color={ $color }]{ $name }[/color]: [color=white]{ $amount }[/color] units
mass-fabricator-examine-empty = [color=gray]No materials loaded.[/color]
