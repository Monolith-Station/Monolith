# MARK: Weapons
uplink-pdv-edagger-name = Energy Dagger
uplink-pdv-edagger-desc = a silent energy blade meant for stealthy combat operations.

uplink-pdv-python-name = LWC Python
uplink-pdv-python-desc = A brutally simple, effective, and loud revolver. Comes loaded with .45 magnum rounds.

uplink-pdv-c20r-name = CS C-20r
uplink-pdv-c20r-desc = a Corporate-Era submachinegun designed for close quarters combat. Uses 9x19mm rounds.

uplink-pdv-wt550-name = UI WT550
uplink-pdv-wt550-desc = a compact smg developed by Ullman Industries. Fires 4.6x30mm rounds.

uplink-pdv-akm-name = LWC AKM
uplink-pdv-akm-desc = An iconic weapon of war. Uses 7.62x39mm ammo.

uplink-pdv-anaconda-name = LWC Anaconda
uplink-pdv-anaconda-desc = a compact and heavy hitting pistol with an inbuilt ammo fabricator.

uplink-pdv-m90-name = PA M-90
uplink-pdv-m90-desc = A compact bullpup rifle that packs a kick. Uses 7.62x51mm.

uplink-pdv-bulldog-name = PA M-12 Bulldog
uplink-pdv-bulldog-desc = a devastating automatic mag fed shotgun. Fires 12 gauge shells.

uplink-pdv-esword-name = Energy Sword
uplink-pdv-esword-desc = a pure concentrated plasma blade. Cuts enemies and doors down with ease.

# MARK: Utility Basic

uplink-pdv-empty-implanter-name = Empty Implanter
uplink-pdv-empty-implanter-desc = A spare, empty implanter to remove implants with, including faction tracking implants. It does not backfire on you.

uplink-pdv-10000credits-name = 10,000 Credits
uplink-pdv-10000credits-desc = 10 thousand big ones

uplink-pdv-jetpack-name = Black Jetpack
uplink-pdv-jetpack-desc = A black jetpack. It allows you to fly around in space. Beware that it emits a radar signature once activated.

uplink-pdv-machine-upgrade-kit-name = Ship Upgrade Kit.
uplink-pdv-machine-upgrade-kit-desc = Contains 32 super capaciters. Can be used to upgrade thrusters, gyroscopes and various other machines.

uplink-pdv-jaws-name = Advanced Jaws of Life
uplink-pdv-jaws-desc = A modified jaws of life that passes safety restrictions, capable of opening doors 2x as fast as a normal JOL.

uplink-pdv-hoverbike-name = Illegal Hoverbike
uplink-pdv-hoverbike-desc = A flatpack containing an illegal hoverbike. Comes with extra luggage capacity.

# MARK: Utility Standard

uplink-pdv-nanite-applicator-name = Advanced Nanite Applicator
uplink-pdv-nanite-applicator-desc = An advanced tool that allows for swift nanotechnology reconstruction to repair structures.

uplink-pdv-access-breaker-name = Authentication Disruptor
uplink-pdv-access-breaker-desc = A device that overrides the access reader on a machine or door, allowing you to access it freely.

uplink-pdv-emag-name = Cryptographic Sequencer
uplink-pdv-emag-desc = A multipurpose hacking device that can configure the ways some machines work.

uplink-pdv-radio-jammer-name = Radio Jammer
uplink-pdv-radio-jammer-desc = This device will disrupt any nearby outgoing radio communication as well as suit sensors when activated.

