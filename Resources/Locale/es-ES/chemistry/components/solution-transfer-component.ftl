### Componente de transferencia de solución

comp-solution-transfer-fill-normal = Llenas {THE($target)} con {$amount}u de {THE($owner)}.
comp-solution-transfer-fill-fully = Llenas {THE($target)} hasta el borde con {$amount}u de {THE($owner)}.
comp-solution-transfer-transfer-solution = Transfieres {$amount}u a {THE($target)}.

## Se muestra al intentar transferir a una solución, pero el donante está vacío o el receptor está lleno
comp-solution-transfer-is-empty = {CAPITALIZE(THE($target))} está vacío.
comp-solution-transfer-is-full = {CAPITALIZE(THE($target))} está lleno.

## Se muestra en el nombre del verbo para cambiar la cantidad de transferencia
comp-solution-transfer-verb-custom-amount = Personalizado
comp-solution-transfer-verb-amount = {$amount}u
comp-solution-transfer-verb-toggle = Cambiar a {$amount}u

## Se muestra después de cambiar correctamente la cantidad de una solución usando la BUI
comp-solution-transfer-set-amount = Cantidad de transferencia establecida en {$amount}u.
comp-solution-transfer-set-amount-max = Máx: {$amount}u
comp-solution-transfer-set-amount-min = Mín: {$amount}u

