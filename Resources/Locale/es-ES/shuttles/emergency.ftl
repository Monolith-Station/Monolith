# Commands
## Delay shuttle round end
emergency-shuttle-command-round-desc = Detiene el temporizador que finaliza la partida cuando el transbordador de emergencia sale del hiperespacio.
emergency-shuttle-command-round-yes = Partida retrasada.
emergency-shuttle-command-round-no = No se puede retrasar el final de la partida.

## Dock emergency shuttle
emergency-shuttle-command-dock-desc = Llama al transbordador de emergencia y lo atraca en la estación... si puede.

## Launch emergency shuttle
emergency-shuttle-command-launch-desc = Lanza el transbordador de emergencia anticipadamente si es posible.

# Emergency shuttle
emergency-shuttle-left = El transbordador de emergencia ha salido de la estación. Se estiman {$transitTime} segundos hasta que el transbordador llegue a CentComm.
emergency-shuttle-launch-time = El transbordador de emergencia partirá en {$consoleAccumulator} segundos.
emergency-shuttle-docked = El transbordador de emergencia ha atracado al {$direction} de la estación, {$location}. Partirá en {$time} segundos.{$extended}
emergency-shuttle-good-luck = El transbordador de emergencia no puede encontrar una estación. Buena suerte.
emergency-shuttle-nearby = El transbordador de emergencia no puede encontrar un puerto de atraque válido. Ha salido del hiperespacio al {$direction} de la estación, {$location}. Partirá en {$time} segundos.{$extended}
emergency-shuttle-extended = {" "}El tiempo de lanzamiento se ha extendido debido a circunstancias desfavorables.

