# Frontier: station<sector
cmd-setalertlevel-desc = Establece el nivel de alerta del sector actual. Se emitirá un anuncio desde la cuadrícula en la que se encuentra el jugador.
cmd-setalertlevel-help = Uso: setalertlevel <level> [locked]
cmd-setalertlevel-invalid-grid = Debes estar en la cuadrícula del código de estación que vas a cambiar.
cmd-setalertlevel-invalid-level = El nivel de alerta especificado no existe en esa cuadrícula.

cmd-setalertlevel-hint-1 = <level>
cmd-setalertlevel-hint-2 = [locked]
