# Brazo Robótico

signal-port-name-input-machine = Elemento: Máquina de Entrada
signal-port-description-input-machine = Una ranura de automatización de máquina para sacar elementos, en lugar de cogerlos del suelo.

signal-port-name-output-machine = Elemento: Máquina de Salida
signal-port-description-output-machine = Una ranura de automatización de máquina para insertar elementos, en lugar de colocarlos en el suelo.

signal-port-name-item-moved = Elemento Movido
signal-port-description-item-moved = Puerto de señal que se activa tras mover un elemento con este brazo.

signal-port-name-automation-slot-filter = Elemento: Ranura de Filtro
signal-port-description-automation-slot-filter = Una ranura de automatización para el filtro de una máquina de automatización.

# Molinillo de Reactivos

signal-port-name-automation-slot-beaker = Elemento: Ranura de Vaso
signal-port-description-automation-slot-beaker = Una ranura de automatización para el vaso de precipitados de una máquina de manipulación de líquidos.

signal-port-name-automation-slot-input = Elemento: Elementos de Entrada
signal-port-description-automation-slot-input = Una ranura de automatización para el almacenamiento de elementos de entrada de una máquina.

# Empaquetador Plano

signal-port-name-automation-slot-board = Elemento: Ranura de Placa
signal-port-description-automation-slot-board = Una ranura de automatización para la placa de circuitos de un empaquetador plano.

signal-port-name-automation-slot-materials = Elemento: Almacenamiento de Materiales
signal-port-description-automation-slot-materials = Una ranura de automatización para insertar materiales en el almacenamiento de una máquina.

# Unidad de Eliminación

signal-port-name-flush = Vaciar
signal-port-description-flush = Puerto de señal para activar o desactivar el mecanismo de vaciado de una unidad de eliminación.

signal-port-name-eject = Expulsar
signal-port-description-eject = Puerto de señal para expulsar el contenido de una unidad de eliminación.

signal-port-name-ready = Lista
signal-port-description-ready = Puerto de señal que se activa tras alcanzar una unidad de eliminación la presurización completa.

# Contenedor de Almacenamiento

signal-port-name-automation-slot-storage = Elemento: Almacenamiento
signal-port-description-automation-slot-storage = Una ranura de automatización para el inventario de un contenedor de almacenamiento.

signal-port-name-storage-inserted = Insertado
signal-port-description-storage-inserted = Puerto de señal que se activa tras insertar un elemento en un contenedor de almacenamiento.

signal-port-name-storage-removed = Retirado
signal-port-description-storage-removed = Puerto de señal que se activa tras retirar un elemento de un contenedor de almacenamiento.

# Máquina de Fax

signal-port-name-automation-slot-paper = Elemento: Papel
signal-port-description-automation-slot-paper = Una ranura de automatización para la bandeja de papel de una máquina de fax.

signal-port-name-fax-copy = Copiar Fax
signal-port-description-fax-copy = Puerto de señal para copiar el papel de una máquina de fax.

# Constructor / Interactor

signal-port-name-machine-start = Iniciar
signal-port-description-machine-start = Puerto de señal para iniciar una máquina una vez.

signal-port-name-machine-autostart = Inicio Automático
signal-port-description-machine-autostart = Puerto de señal para controlar el inicio automático tras completarse.

signal-port-name-machine-started = Iniciado
signal-port-description-machine-started = Puerto de señal que se activa tras iniciarse una máquina.

signal-port-name-machine-completed = Completado
signal-port-description-machine-completed = Puerto de señal que se activa tras completar su trabajo una máquina.

signal-port-name-machine-failed = Fallido
signal-port-description-machine-failed = Puerto de señal que se activa tras fallar el inicio de una máquina.

# Interactor

signal-port-name-automation-slot-tool = Elemento: Herramienta
signal-port-description-automation-slot-tool = Una ranura de automatización para la herramienta sostenida de un interactor.

# Autodoc

signal-port-name-automation-slot-autodoc-hand = Elemento: Mano del Autodoc
signal-port-description-automation-slot-autodoc-hand = Una ranura de automatización para el órgano/parte/etc sostenido por un autodoc desde las instrucciones STORE ITEM / GRAB ITEM.

# Canister de Gas

signal-port-name-automation-slot-gas-tank = Elemento: Tanque de Gas
signal-port-description-automation-slot-gas-tank = Una ranura de automatización para un tanque de gas.

# Colector de Radiación

signal-port-name-rad-empty = Vacío
signal-port-description-rad-empty = Puerto de señal establecido en ALTO si el tanque está ausente o por debajo del 33% de presión, BAJO en caso contrario.

signal-port-name-rad-low = Bajo
signal-port-description-rad-low = Puerto de señal establecido en ALTO si el tanque está por debajo del 66% de presión, BAJO en caso contrario.

signal-port-name-rad-full = Lleno
signal-port-description-rad-full = Puerto de señal establecido en ALTO si el tanque está por encima del 66% de presión, BAJO en caso contrario.
