
### Mensajes de interacción

# Al intentar comer alimentos sin el utensilio necesario... pero tienes que sujetarlo
food-you-need-to-hold-utensil = ¡Necesitas sujetar un {$utensil} para comer eso!

food-nom = Ñam. {$flavors}
food-swallow = Tragas el {$food}. {$flavors}

food-has-used-storage = No puedes comer el {$food} con un objeto guardado dentro.

food-system-remove-mask = Necesitas quitarte el {$entity} primero.

## Sistema

food-system-you-cannot-eat-any-more = ¡No puedes comer más!
food-system-you-cannot-eat-any-more-other = {CAPITALIZE(SUBJECT($target))} no puede comer más.
food-system-try-use-food-is-empty = {CAPITALIZE(THE($entity))} está vacío.
food-system-wrong-utensil = No puedes comer {THE($food)} con {INDEFINITE($utensil)} {$utensil}.
food-system-cant-digest = ¡No puedes digerir {THE($entity)}!
food-system-cant-digest-other = {CAPITALIZE(SUBJECT($target))} no puede digerir {THE($entity)}.

food-system-verb-eat = Comer

## Alimentación forzada

food-system-force-feed = {CAPITALIZE(THE($user))} está intentando darte de comer algo.
food-system-force-feed-success = {CAPITALIZE(THE($user))} te ha forzado a comer algo. {$flavors}
food-system-force-feed-success-user = Has dado de comer con éxito a {THE($target)}
