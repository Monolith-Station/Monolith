set-game-preset-command-description = Establece el modo de juego predefinido para el número especificado de partidas siguientes. También puede mostrar el título y la descripción de otro modo predefinido en el vestíbulo para engañar a los jugadores.
set-game-preset-command-help-text = setgamepreset <id> [número de partidas, por defecto 1] [modo señuelo]
set-game-preset-command-hint-1 = <id>
set-game-preset-command-hint-2 = [número de partidas]
set-game-preset-command-hint-3 = [modo señuelo]

set-game-preset-optional-argument-not-integer = Si se proporciona el argumento 2, debe ser un número.
set-game-preset-preset-error = No se puede encontrar el modo de juego predefinido "{$preset}"
set-game-preset-decoy-error = Si se proporciona el argumento 3, debe ser un modo predefinido válido. No se puede encontrar el modo de juego predefinido "{$preset}"

#set-game-preset-preset-set = Establecer modo de juego predefinido en "{$preset}"
set-game-preset-preset-set-finite = Modo de juego predefinido establecido en "{$preset}" para las próximas {$rounds} partidas.
set-game-preset-preset-set-finite-with-decoy = Modo de juego predefinido establecido en "{$preset}" para las próximas {$rounds} partidas, mostrando {$decoy} en el vestíbulo.
