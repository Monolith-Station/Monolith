thief-backpack-window-title = kit indeterminado

thief-backpack-window-description =
    En el interior están tus herramientas del oficio, que se disolverán cuando estés listo.
    Elige {$maxCount} { $maxCount ->
        [1] conjunto diferente
        *[other] conjuntos diferentes
    } de la lista.

thief-backpack-window-selected = Kits seleccionados: ({$selectedCount}/{$maxCount})

thief-backpack-window-approve-button = Aprobar
thief-backpack-button-select = Seleccionar [  ]
thief-backpack-button-deselect = Seleccionar [X]

# Sets

thief-backpack-category-chameleon-name = kit camaleón
thief-backpack-category-chameleon-description =
    Eres todos y ninguno; eres un maestro del disfraz.
    Incluye: Un conjunto completo de ropa camaleón,
    un proyector camaleón y una ID de Agente.
    Disfrázate de cualquier persona y cualquier cosa.

thief-backpack-category-tools-name = kit de intrusión
thief-backpack-category-tools-description =
    ¿Qué es ese sonido? Un pequeño C4 llamando a su puerta.
    ¡Ningún obstáculo puede detenerte!
    Incluye: Dos C4, una multiherramienta, un señalizador remoto, unas mandíbulas de la vida,
    un soldador avanzado, gafas de ingeniería y guantes aislados.

thief-backpack-category-chemistry-name = kit de anatomía
thief-backpack-category-chemistry-description =
    Has alcanzado el rendimiento físico máximo... con un poco de ayuda.
    Incluye: Implantador de almacenamiento, implantador de descodificador de ADN,
    botella de efedrina, jeringa, coctelera vacía y jabón omega

thief-backpack-category-syndie-name = kit syndie
thief-backpack-category-syndie-description =
    ¿Baratijas de un pasado repudiado, o robadas a un agente descuidado?
    Has hecho algunas conexiones. Whiskey, echo...
    Incluye: Un Emag, un Violador de Accesos, cigarrillos Interdyne, una contraseña del Syndicate,
    un Bloqueador de Radio, un encendedor y unos extraños cristales rojos.

thief-backpack-category-sleeper-name = kit dormilón
thief-backpack-category-sleeper-description =
    Hasta que cerremos los ojos para siempre, usa tus prescripciones ilegales
    para mantener a los demás dormidos.
    Incluye: Tanque de óxido nitroso somnífero, dos botellas de nocturina,
    y un hypopen.

thief-backpack-category-communicator-name = kit de comunicador
thief-backpack-category-communicator-description =
    El dinero es poder, y los secretos son dinero. Usa tu lengua de plata
    y tu riqueza para subvertir la estación.
    Incluye: Llave maestra para todos los canales de la estación, un bolígrafo CyberSun,
    máscara camaleón de voz y 20 000 créditos dentro de un maletín.

thief-backpack-category-smuggler-name = kit de contrabandista
thief-backpack-category-smuggler-description =
    Todo ladrón necesita un lugar donde esconder sus bienes en la oscuridad.
    No olvides vincular tu fulton.
    Incluye: Baliza fulton, 10 fultones, 3 granadas de humo,
    y un cajón invisible para esconder el botín valioso.
