# también usado en MakeGhostRuleWindow y MakeGhostRoleCommand
ghost-role-component-default-rules = Se aplican todas las reglas normales a menos que un administrador te indique lo contrario.
                                     No recuerdas nada de tu vida anterior, ni nada que hayas aprendido como fantasma.
                                     Se te permite recordar conocimientos sobre el juego en general, como cocinar, usar objetos, etc.
                                     Está absolutamente [color=red]PROHIBIDO[/color] recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior.
ghost-role-information-nonantagonist-rules = Eres un [color=green][bold]No-antagonista[/bold][/color]. En general, no debes buscar dañar la estación ni a su tripulación.
                                             No recuerdas nada de tu vida anterior, ni nada que hayas aprendido como fantasma.
                                             Se te permite recordar conocimientos sobre el juego en general, como cocinar, usar objetos, etc.
                                             Está absolutamente [color=red]PROHIBIDO[/color] recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior.
ghost-role-information-freeagent-rules = Eres un [color=yellow][bold]Agente Libre[/bold][/color]. Eres libre de actuar como antagonista o no antagonista.
                                         No recuerdas nada de tu vida anterior, ni nada que hayas aprendido como fantasma.
                                         Se te permite recordar conocimientos sobre el juego en general, como cocinar, usar objetos, etc.
                                         Está absolutamente [color=red]PROHIBIDO[/color] recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior.
ghost-role-information-antagonist-rules = Eres un [color=red][bold]Antagonista Solitario[/bold][/color]. Tus intenciones son claras y perjudiciales para la estación y su tripulación.
                                          No recuerdas nada de tu vida anterior, ni nada que hayas aprendido como fantasma.
                                          Se te permite recordar conocimientos sobre el juego en general, como cocinar, usar objetos, etc.
                                          Está absolutamente [color=red]PROHIBIDO[/color] recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior.
ghost-role-information-rules-team-antagonist = Eres un [color=red][bold]Antagonista de Equipo[/bold][/color]. Tus intenciones son claras y perjudiciales para la estación y su tripulación.
                                               Debes [bold]trabajar con tu equipo[/bold] o seguir las instrucciones razonables de tus líderes de equipo.
                                               No recuerdas nada de tu vida anterior, ni nada que hayas aprendido como fantasma.
                                               Se te permite recordar conocimientos sobre el juego en general, como cocinar, usar objetos, etc.
                                               Está absolutamente [color=red]PROHIBIDO[/color] recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior.
ghost-role-information-familiar-rules = Eres un [color=#6495ed][bold]Familiar[/bold][/color]. Sirve los intereses de tu amo, sean cuales sean.
                                        No recuerdas nada de tu vida anterior, ni nada que hayas aprendido como fantasma.
                                        Se te permite recordar conocimientos sobre el juego en general, como cocinar, usar objetos, etc.
                                        Está absolutamente [color=red]PROHIBIDO[/color] recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior.
ghost-role-information-silicon-rules = Eres un [color=#6495ed][bold]Silicon[/bold][/color]. Obedece tus leyes. Eres un Agente Libre si no estás vinculado actualmente por ninguna ley.
                                       No recuerdas nada de tu vida anterior, ni nada que hayas aprendido como fantasma.
                                       Se te permite recordar conocimientos sobre el juego en general, como cocinar, usar objetos, etc.
                                       Está absolutamente [color=red]PROHIBIDO[/color] recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior.

ghost-role-information-mouse-name = Ratón
ghost-role-information-mouse-description = Un ratón hambriento y travieso.

ghost-role-information-mothroach-name = Mothroach
ghost-role-information-mothroach-description = Un mothroach adorable pero travieso.

ghost-role-information-snail-name = Caracol
ghost-role-information-snail-description = Un pequeño caracol al que no le importa un poco de espacio. ¡Mantente en la cuadrícula!

ghost-role-information-snailspeed-name = Caracol
ghost-role-information-snailspeed-description = Un pequeño caracol con propulsores de caracol.

ghost-role-information-snoth-name = Snoth
ghost-role-information-snoth-description = Un pequeño snoth al que no le importa un poco de espacio. ¡Mantente en la cuadrícula!

ghost-role-information-giant-spider-name = Araña Gigante
ghost-role-information-giant-spider-description = ¡Los habitantes de esta estación parecen muy apetecibles, y tu pegajosa telaraña es perfecta para atraparlos!
ghost-role-information-giant-spider-rules = Eres un [color=red][bold]Antagonista de Equipo[/bold][/color] con todas las demás arañas gigantes.

ghost-role-information-cognizine-description = Dotado de consciencia gracias a la magia de la cognizina.

ghost-role-information-hamster-name = Hámster
ghost-role-information-hamster-description = Una pequeña y malhumorada bola de pelo.

ghost-role-information-hamlet-name = Hamlet el Hámster
ghost-role-information-hamlet-description = Vive en el puente de la estación, tiene bastante mal genio y siempre tiene hambre.

ghost-role-information-slimes-name = Slime
ghost-role-information-slimes-description = Un slime ordinario sin necesidades ni intereses especiales. Eres amistoso con los demás.

ghost-role-information-angry-slimes-name = Slime
ghost-role-information-angry-slimes-description = ¡Todos a tu alrededor irritan tus instintos, destrúyelos!
ghost-role-information-angry-slimes-rules = Eres un [color=red][bold]Antagonista de Equipo[/bold][/color] con todos los demás slimes enfurecidos.

ghost-role-information-smile-name = Smile el Slime
ghost-role-information-smile-description = La criatura más dulce del mundo. ¡Sonríe, slime!

ghost-role-information-punpun-name = Pun Pun
ghost-role-information-punpun-description = Un honorable miembro de la sociedad de los monos encargado del bar y de ayudar a los camareros en todo lo que pueda.

ghost-role-information-xeno-name = Xeno
ghost-role-information-xeno-description = ¡Eres un xeno, coopera con tu colmena para matar a todos los miembros de la tripulación!
ghost-role-information-xeno-rules = Eres un [color=red][bold]Antagonista de Equipo[/bold][/color] con todos los demás xenos.

ghost-role-information-revenant-name = Revenant
ghost-role-information-revenant-description = Eres un Revenant. Usa tus poderes para cosechar almas y desatar el caos sobre la tripulación. Desbloquea nuevas habilidades con la esencia que recolectas.

ghost-role-information-kangaroo-name = Canguro
ghost-role-information-kangaroo-description = ¡Eres un canguro! Haz lo que hacen los canguros.

ghost-role-information-monkey-name = Mono
ghost-role-information-monkey-description = ¡Ook ook!

ghost-role-information-kobold-name = Kobold
ghost-role-information-kobold-description = ¡Sé el pequeño duende que eres, grita a la gente y mendiga carne!

ghost-role-information-rat-king-name = Rey de las Ratas

ghost-role-information-rat-king-description = Eres el Rey de las Ratas, tus intereses son la comida, la comida y más comida. Coopera o lucha contra la estación por comida. ¿Dije que la comida te interesa?

ghost-role-information-rat-servant-name = Sirviente de las Ratas
ghost-role-information-rat-servant-description = Eres un Sirviente de las Ratas. Debes seguir las órdenes de tu rey.

ghost-role-information-salvage-carp-name = Carpa Espacial en Restos de Salvamento
ghost-role-information-salvage-carp-description = ¡Defiende el botín dentro de los restos del salvamento!

ghost-role-information-sentient-carp-name = Carpa Sintiente
ghost-role-information-sentient-carp-description = ¡Ayuda al dragón a inundar la estación con carpas!

ghost-role-information-willow-name = Willow el Canguro
ghost-role-information-willow-description = ¡Eres un canguro llamado Willow! A Willow le gusta boxear.

ghost-role-information-honkbot-name = Honkbot
ghost-role-information-honkbot-description = Un ser artificial de puro mal.

ghost-role-information-jonkbot-name = Jonkbot
ghost-role-information-jonkbot-description = Un ser artificial de puro mal.

ghost-role-information-mimebot-name = Mimebot
ghost-role-information-mimebot-description = Un Mimebot, actúa como un mimo pero no como un greytider.

ghost-role-information-supplybot-name = SupplyBot
ghost-role-information-supplybot-description = Reparte mercancías por la estación.

ghost-role-information-space-bear-name = Oso Espacial
ghost-role-information-space-bear-description = Tu barriga ruge, y esta gente parece muy sabrosa... ¡Qué festín!

# Todavía existe como referencia comentada para Tropico. Se mantiene. -TsjipTsjip, 2024-06-20
ghost-role-information-tropico-name = Tropico
ghost-role-information-tropico-description = El noble compañero de Atmosia, y su defensor más firme. ¡Viva!

ghost-role-information-guardian-name = Guardián
ghost-role-information-guardian-description = Escucha a tu dueño. No absortas daño. Golpea fuerte a la gente.

ghost-role-information-holoparasite-name = Holoparásito
ghost-role-information-holoparasite-description = Escucha a tu dueño. No absortas daño. Golpea fuerte a la gente.

ghost-role-information-holoclown-name = Holoclown
ghost-role-information-holoclown-description = Escucha a tu dueño. Usa tus bolsillos y manos para ayudar a tu dueño.

ghost-role-information-ifrit-name = Ifrit
ghost-role-information-ifrit-description = Escucha a tu dueño. No absortas daño. Golpea fuerte a la gente.

ghost-role-information-space-dragon-name = Dragón Espacial
ghost-role-information-space-dragon-description = ¡Convoca 3 grietas de carpas y toma el control de este cuadrante! Solo tienes 5 minutos entre cada grieta antes de desaparecer.
ghost-role-information-space-dragon-rules = Eres un [color=red][bold]Antagonista de Equipo[/bold][/color] con todas tus carpas invocadas.
ghost-role-information-space-dragon-summoned-carp-rules = Eres un [color=red][bold]Antagonista de Equipo[/bold][/color] con tu dragón y sus aliados.

ghost-role-information-space-dragon-dungeon-description = ¡Defiende la mazmorra de la expedición con tus camaradas escamosos!
ghost-role-information-space-dragon-dungeon-rules = Eres un [color=red][bold]Antagonista de Equipo[/bold][/color] con todas las criaturas de la mazmorra.

ghost-role-information-cluwne-name = Cluwne
ghost-role-information-cluwne-description = Conviértete en un lastimoso cluwne, tu único objetivo en la vida es encontrar un dulce alivio a tu sufrimiento (generalmente siendo golpeado hasta la muerte). Un cluwne no es un antagonista pero puede defenderse. Los miembros de la tripulación pueden matar cluwnes libremente.

ghost-role-information-skeleton-pirate-name = Pirata Esqueleto
ghost-role-information-skeleton-pirate-description = Causa caos y saquea la estación en busca de tesoros.

ghost-role-information-skeleton-biker-name = Motociclista Esqueleto
ghost-role-information-skeleton-biker-description = Conduce por ahí en tu genial montura.

ghost-role-information-closet-skeleton-name = Esqueleto del Armario
ghost-role-information-closet-skeleton-description = ¡Eres sin duda uno de los miembros más antiguos de la estación! Recupera tu antiguo trabajo, ¡o causa caos! El mundo es tuyo para moldearlo.

ghost-role-information-remilia-name = Remilia, el Familiar del Capellán
ghost-role-information-remilia-description = Sigue y obedece al capellán. Come fruta. Chilla en los oídos de la gente y achácalo a la ecolocalización.

ghost-role-information-cerberus-name = Cerberus, Familiar Malvado
ghost-role-information-cerberus-description = Obedece a tu amo. Siembra el caos.

ghost-role-information-ert-leader-name = Líder del ERT
ghost-role-information-ert-leader-description = Lidera un equipo de especialistas para resolver los problemas de la estación.

ghost-role-information-ert-chaplain-name = Capellán del ERT
ghost-role-information-ert-chaplain-description = Asiste con el duelo para resolver los problemas morales de la tripulación de la estación.

ghost-role-information-ert-janitor-name = Conserje del ERT
ghost-role-information-ert-janitor-description = Asiste con las labores de limpieza para resolver los problemas de la estación.

ghost-role-information-ert-engineer-name = Ingeniero del ERT
ghost-role-information-ert-engineer-description = Asiste con las labores de ingeniería para resolver los problemas de la estación.

ghost-role-information-ert-security-name = Seguridad del ERT
ghost-role-information-ert-security-description = Asiste con las labores de seguridad para resolver los problemas de la estación.

ghost-role-information-ert-medical-name = Médico del ERT
ghost-role-information-ert-medical-description = Asiste con las labores médicas para resolver los problemas de la estación.

ghost-role-information-cburn-agent-name = Agente CBURN
ghost-role-information-cburn-agent-description = Un agente de CentComm altamente entrenado, capaz de hacer frente a diversas amenazas.

ghost-role-information-centcom-official-name = Oficial de CentComm
ghost-role-information-centcom-official-description = Realiza tareas relacionadas con CentComm, como inspeccionar la estación, anotar evaluaciones de rendimiento de los jefes de personal y gestionar el fax.

ghost-role-information-nukeop-rules = Eres un [color=red][bold]Antagonista de Equipo[/bold][/color] con todos los demás operativos nucleares. Los agentes encubiertos del Syndicate no tienen la obligación de ayudarte.

ghost-role-information-loneop-name = Operativo Solitario
ghost-role-information-loneop-description = Eres un operativo nuclear solitario. ¡Destruye la estación!
ghost-role-information-loneop-rules = Eres un [color=red][bold]Antagonista Solitario[/bold][/color]. Los agentes encubiertos del Syndicate no tienen la obligación de ayudarte.

ghost-role-information-behonker-name = Behonker
ghost-role-information-behonker-description = Eres un antagonista, lleva la muerte y los honks a quienes no sigan a la madre del honk.

ghost-role-information-hellspawn-name = Engendro Infernal
ghost-role-information-hellspawn-description = Lleva la muerte a quienes no sigan al gran dios Nar'Sie.

ghost-role-information-Death-Squad-name = Operativo del Escuadrón de la Muerte
ghost-role-information-Death-Squad-description = Uno de los mejores agentes del TSF. Espera órdenes de un oficial del Gobierno Central.
ghost-role-information-Death-Squad-rules = Estás obligado a obedecer las órdenes de tu superior, eres efectivamente su [color=#6495ed][bold]Familiar[/bold][/color].

ghost-role-information-SyndiCat-name = SyndiCat
ghost-role-information-SyndiCat-description = Eres la fiel mascota entrenada de los operativos nucleares con una microbomba. ¡Sirve a tu amo hasta la muerte!
ghost-role-information-SyndiCat-rules = Eres un [color=red][bold]Antagonista de Equipo[/bold][/color] con el agente que te invocó.

ghost-role-information-Cak-name = Cak
ghost-role-information-Cak-description = Eres el hijo favorito del cocinero. Eres un gato pastel viviente.

ghost-role-information-BreadDog-name = BreadDog
ghost-role-information-BreadDog-description = Eres el hijo favorito del cocinero. Eres un perro de pan viviente.

ghost-role-information-space-ninja-name = Ninja Espacial
ghost-role-information-space-ninja-description = Usa el sigilo y el engaño para sabotear la estación.

ghost-role-information-syndicate-reinforcement-name = Agente del Syndicate
ghost-role-information-syndicate-reinforcement-description = Alguien necesita refuerzos. Tú, la primera persona que el Syndicate pudo encontrar, los ayudarás.
ghost-role-information-syndicate-reinforcement-rules = Eres un [color=red][bold]Antagonista de Equipo[/bold][/color] con el agente que te invocó.

ghost-role-information-syndicate-reinforcement-medic-name = Médico del Syndicate
ghost-role-information-syndicate-reinforcement-medic-description = Alguien necesita refuerzos. Tu tarea es mantener con vida al agente que te llamó.

ghost-role-information-syndicate-reinforcement-spy-name = Espía del Syndicate
ghost-role-information-syndicate-reinforcement-spy-description = Alguien necesita refuerzos. Tu especialidad está en el espionaje, no te descubran.

ghost-role-information-syndicate-reinforcement-thief-name = Ladrón del Syndicate
ghost-role-information-syndicate-reinforcement-thief-description = Alguien necesita refuerzos. Tu trabajo es entrar por la fuerza y recuperar algo valioso para tu agente.

ghost-role-information-nukeop-reinforcement-name = Operativo Nuclear
ghost-role-information-nukeop-reinforcement-description = Los operativos nucleares necesitan refuerzos. Tú, un agente de reserva, los ayudarás.
ghost-role-information-nukeop-reinforcement-rules = Eres un [color=red][bold]Antagonista de Equipo[/bold][/color] con los operativos nucleares que te invocaron.

ghost-role-information-syndicate-monkey-reinforcement-name = Agente Mono del Syndicate
ghost-role-information-syndicate-monkey-reinforcement-description = Alguien necesita refuerzos. Tú, un mono entrenado, los ayudarás.

ghost-role-information-syndicate-kobold-reinforcement-name = Agente Kobold del Syndicate
ghost-role-information-syndicate-kobold-reinforcement-description = Alguien necesita refuerzos. Tú, un kobold entrenado, los ayudarás.

ghost-role-information-syndicate-cyborg-assault-name = Cyborg de Asalto del Syndicate
ghost-role-information-syndicate-cyborg-saboteur-name = Cyborg Saboteador del Syndicate
ghost-role-information-syndicate-cyborg-description = El Syndicate necesita refuerzos. Tú, una fría máquina de matar de silicio, los ayudarás.

ghost-role-information-derelict-cyborg-name = Cyborg Abandonado
ghost-role-information-derelict-cyborg-description = Eres un cyborg normal que se perdió en el espacio. Tras años de exposición a tormentas de iones, te encuentras cerca de una estación espacial.

ghost-role-information-security-name = Seguridad
ghost-role-information-security-description = Formas parte de un grupo de trabajo de seguridad, pero parece que te has encontrado en una situación extraña...

ghost-role-information-medical-name = Médico
ghost-role-information-medical-virologist-name = Virólogo
ghost-role-information-medical-geneticist-name = Genetista
ghost-role-information-medical-dentist-name = Dentista
ghost-role-information-medical-description = Eres un profesional médico, pero parece que te has encontrado en una situación extraña...

ghost-role-information-cargo-name = Logística
ghost-role-information-cargo-description = Formas parte de una misión logística, pero parece que te has encontrado en una situación extraña...

ghost-role-information-engineering-name = Ingeniería
ghost-role-information-engineering-description = Estás en un trabajo de ingeniería, pero parece que te has encontrado en una situación extraña...

ghost-role-information-science-name = Ciencia
ghost-role-information-science-description = Formas parte de un equipo científico, pero parece que te has encontrado en una situación extraña...

ghost-role-information-civilian-name = Civil
ghost-role-information-civilian-description = Estabas simplemente pasando el rato, pero parece que te has encontrado en una situación extraña...
ghost-role-information-civilian-centcom-lawyer-name = Abogado de CentComm
ghost-role-information-civilian-centcom-lawyer-description = Un abogado directo de la División Legal Central.

ghost-role-information-command-name = Comandante
ghost-role-information-command-description = Eres miembro del mando, pero parece que te has encontrado en una situación extraña...

ghost-role-information-lost-challenge-commander-name = Comandante de Permiso
ghost-role-information-lost-challenge-commander-description = Eres un miembro del mando de otra nave estelar al que se le concedió permiso junto con uno de tus técnicos de carga.
ghost-role-information-lost-challenge-commander-rules = No eres hostil a la estación, haz lo que debas para garantizar tu propia supervivencia.
                                     No recuerdas nada de tu vida anterior, ni nada que hayas aprendido como fantasma.
                                     Se te permite recordar conocimientos sobre el juego en general, como cocinar, usar objetos, etc.
                                     Está absolutamente [color=red]PROHIBIDO[/color] recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior.

ghost-role-information-lost-challenge-cargo-technican-name = Chofer de Carga
ghost-role-information-lost-challenge-cargo-technican-description = Eres un técnico de carga al que se le concedió permiso junto con uno de tus oficiales al mando.
ghost-role-information-lost-challenge-cargo-technican-rules = No eres hostil a la estación, haz lo que debas para garantizar tu propia supervivencia.
                                     No recuerdas nada de tu vida anterior, ni nada que hayas aprendido como fantasma.
                                     Se te permite recordar conocimientos sobre el juego en general, como cocinar, usar objetos, etc.
                                     Está absolutamente [color=red]PROHIBIDO[/color] recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior.

ghost-role-information-disaster-victim-name = Víctima de Desastre
ghost-role-information-disaster-victim-description = Fuiste rescatado en una cápsula de escape de otra estación que sufrió un terrible destino. Quizás te encuentren y rescaten.

ghost-role-information-syndie-disaster-victim-name = Víctima de Desastre del Syndicate
ghost-role-information-syndie-disaster-victim-description = Eres un pasajero normal de una estación del Syndicate. Desafortunadamente, una cápsula de evacuación te ha lanzado a un sector enemigo...

ghost-role-information-syndie-soldier-name = Soldado del Syndicate
ghost-role-information-syndie-soldier-description = Eres un soldado del Syndicate.

ghost-role-information-syndie-soldier-teamlead-name = Líder de Equipo del Syndicate
ghost-role-information-syndie-soldier-teamlead-description = Eres el líder del grupo de fuego de un grupo de operativos del Syndicate.

ghost-role-information-blackmarketeer-name = Comerciante del Mercado Negro
ghost-role-information-blackmarketeer-description = Haz tratos o acepta trabajos esporádicos para reunir los objetos más interesantes antes de que acabe el turno.

ghost-role-information-cossack-name = Viajero Antiguo
ghost-role-information-cossack-description = Desde una historia perdida en el tiempo, te encuentras arrojado a esta época.

ghost-role-information-pirate-name = Pirata Espacial
ghost-role-information-pirate-description = ¡Argh, amigo! Recoge botín genial, ¡pero asegúrate de evitar a la seguridad y el salvamento!

ghost-role-information-pirate-captain-name = Capitán Pirata Espacial
ghost-role-information-pirate-captain-description = ¡Argh, amigo! Estás al mando aquí y necesitas idear un plan para hacerte con ese suculento botín por las buenas o por las malas. ¡Asegúrate de evitar a la seguridad y el salvamento!

ghost-role-information-artifact-name = Artefacto Sintiente
ghost-role-information-artifact-description = Ejecuta tus caprichos arcanos. Activa tus nodos a la fuerza para bien o para mal.

ghost-role-information-tomatokiller-name = Asesino de Tomates
ghost-role-information-tomatokiller-description = Este pequeño tomate servirá al botánico por el resto de su vida... es decir, un par de minutos.

ghost-role-information-gingerbread-name = Hombre de Jengibre
ghost-role-information-gingerbread-description = Un ser de puro espíritu festivo.
                                     Extiende la bondad de la melaza y alegría a todos.

ghost-role-information-wizard-name = Mago
ghost-role-information-wizard-desc = ¡ERES UN MAGO! Muéstrale a la estación de qué está hecha tu magia.
