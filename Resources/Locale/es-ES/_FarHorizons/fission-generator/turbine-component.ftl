### Ventanas emergentes

# Mostrado cuando ocurre un evento
turbine-overheat = ¡{ $owner } activa la válvula de descarga de emergencia por sobrecalentamiento!
turbine-explode = ¡La { $owner } se destroza a sí misma!

# Mostrado cuando se produce daño
turbine-spark = ¡La { $owner } empieza a chispear!
turbine-spark-stop = La { $owner } deja de chispear.
turbine-smoke = ¡La { $owner } empieza a humear!
turbine-smoke-stop = La { $owner } deja de humear.

# Mostrado durante las reparaciones
turbine-repair-ruined = Reparas la carcasa de { $target } con { $tool }.
turbine-repair = Reparas parte del daño en { $target } usando { $tool }.
turbine-no-damage = No hay daño que reparar en { $target } usando { $tool }.
turbine-show-damage = Salud del Aspa { $health }, Salud Máx. del Aspa { $healthMax }.

# Advertencias de anclaje
turbine-unanchor-warning = ¡No puedes desanclar la turbina de gas mientras está girando!
turbine-anchor-warning = Posición de anclaje no válida.

