### EmitterComponent

# Shows when attempting to turn the emitter on or off without proper access
comp-emitter-access-locked = ¡{$target} está bloqueado por acceso!

# Shows when turning the emitter on/off
comp-emitter-turned-on = {$target} se enciende.

comp-emitter-turned-off = {$target} se apaga.

# Shows if the user attempts to activate the emitter while it's un-anchored.
comp-emitter-not-anchored = ¡{$target} no está anclado al suelo!

# Upgrades
emitter-component-upgrade-fire-rate = cadencia de disparo

emitter-component-current-type = El tipo seleccionado actualmente es: {$type}.
emitter-component-type-set = Tipo establecido en: {$type}
