signal-port-name-pressed = Pulsado
signal-port-description-pressed = Este puerto se activa cuando el transmisor es accionado.

signal-port-name-on-transmitter = Encendido
signal-port-description-on-transmitter = Este puerto se activa cuando el transmisor se enciende.

signal-port-name-off-transmitter = Apagado
signal-port-description-off-transmitter = Este puerto se activa cuando el transmisor se apaga.

signal-port-name-status-transmitter = Estado
signal-port-description-status-transmitter = Este puerto se activa con ALTA o BAJA dependiendo del estado del transmisor.

signal-port-name-left = Izquierda
signal-port-description-left = Este puerto se activa cuando la palanca se mueve a la posición más a la izquierda.

signal-port-name-right = Derecha
signal-port-description-right = Este puerto se activa cuando la palanca se mueve a la posición más a la derecha.

signal-port-name-doorstatus = Estado de la puerta
signal-port-description-doorstatus = Este puerto se activa con ALTA cuando la puerta se abre y BAJA cuando la puerta termina de cerrarse.

signal-port-name-dockstatus = Estado de atraque
signal-port-description-dockstatus = Este puerto se activa con ALTA cuando está atracado y BAJA cuando está desatracado.

signal-port-name-middle = Centro
signal-port-description-middle = Este puerto se activa cuando la palanca se mueve a la posición neutral.

signal-port-name-timer-trigger = Disparador de temporizador
signal-port-description-timer-trigger = Este puerto se activa cuando el temporizador se dispara.

signal-port-name-timer-start = Inicio de temporizador
signal-port-description-timer-start = Este puerto se activa cuando el temporizador se inicia.

signal-port-name-logic-output = Salida
signal-port-description-logic-output = Este puerto se activa con ALTA o BAJA dependiendo de la puerta seleccionada y las entradas.

signal-port-name-logic-output-high = Salida alta
signal-port-description-logic-output-high = Este puerto se activa cuando la entrada tiene un flanco ascendente.

signal-port-name-logic-output-low = Salida baja
signal-port-description-logic-output-low = Este puerto se activa cuando la entrada tiene un flanco descendente.

signal-port-name-air-danger = Peligro
signal-port-description-air-danger = Este puerto se activa con ALTA cuando está en modo de peligro y BAJA cuando no.

signal-port-name-air-warning = Advertencia
signal-port-description-air-warning = Este puerto se activa con ALTA cuando está en modo de advertencia y BAJA cuando no.

signal-port-name-air-normal = Normal
signal-port-description-air-normal = Este puerto se activa con ALTA cuando está en modo normal y BAJA cuando no.

signal-port-name-decaying = Decayendo
signal-port-description-decaying = Este puerto se activa cuando una anomalía vinculada comienza a decaer.

signal-port-name-stabilize = Estabilizar
signal-port-description-stabilize = Este puerto se activa cuando una anomalía vinculada se normaliza.

signal-port-name-growing = Creciendo
signal-port-description-growing = Este puerto se activa cuando una anomalía vinculada comienza a crecer.

signal-port-name-pulse = Pulso
signal-port-description-pulse = Este puerto se activa cuando una anomalía vinculada está pulsando.

signal-port-name-supercrit = Supercrítico
signal-port-description-supercrit = Este puerto se activa cuando una anomalía vinculada explota tras alcanzar el estado supercrítico.

signal-port-name-power-charging = Cargando
signal-port-description-power-charging = Este puerto se activa con ALTA cuando la batería está ganando carga y BAJA cuando no.

signal-port-name-power-discharging = Descargando
signal-port-description-power-discharging = Este puerto se activa con ALTA cuando la batería está perdiendo carga y BAJA cuando no.
