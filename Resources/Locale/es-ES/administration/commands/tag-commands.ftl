addtag-command-description = Añade una etiqueta a una entidad dada
addtag-command-help = Uso: addtag <entity uid> <tag>

addtag-command-success = Se añadió {$tag} a {$target}.
addtag-command-fail = No se pudo añadir {$tag} a {$target}.

removetag-command-description = Elimina una etiqueta de una entidad dada
removetag-command-help = Uso: removetag <entity uid> <tag>

removetag-command-success = Se eliminó {$tag} de {$target}.
removetag-command-fail = No se pudo eliminar {$tag} de {$target}.

tag-command-arg-tag = Etiqueta
