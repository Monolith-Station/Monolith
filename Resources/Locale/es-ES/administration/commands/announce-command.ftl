cmd-announce-desc = Envía un anuncio en el juego con color y sonido personalizados.
cmd-announce-help = {$command} <mensaje> [remitente] [color] [sonido] - Envía un anuncio. El remitente predeterminado es CentCom, el color es Dorado, el sonido es announce.ogg. El color debe estar en formato #RRGGBB.

# El remitente predeterminado del anuncio
cmd-announce-sender = Mando Central

# Sugerencias de completado
cmd-announce-arg-message = <mensaje>
cmd-announce-arg-sender = [remitente]
cmd-announce-arg-color = [color]
cmd-announce-arg-sound = [sonido]
