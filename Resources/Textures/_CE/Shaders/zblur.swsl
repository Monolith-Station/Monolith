light_mode unshaded;
blend_mode none;

uniform sampler2D SCREEN_TEXTURE;
uniform highp vec2 AXIS;
uniform highp vec3 TINT;
uniform highp int KERNEL_RADIUS;
uniform highp float[13] WEIGHTS;

void fragment() {
    highp vec2 uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE;
    highp vec2 stepUv = 2.0 * AXIS * SCREEN_PIXEL_SIZE;
    highp vec4 blurred = WEIGHTS[0] * zTextureSpec(SCREEN_TEXTURE, uv);
    for (int i = 1; i <= 12; i++) {
        if (i > KERNEL_RADIUS) {
            break;
        }
        highp vec2 delta = float(i) * stepUv;
        blurred += WEIGHTS[i] * (zTextureSpec(SCREEN_TEXTURE, uv + delta)
            + zTextureSpec(SCREEN_TEXTURE, uv - delta));
    }

    COLOR = vec4(blurred.rgb * TINT, blurred.a);
}
