// Blend the scratch viewport over the scene so uncovered pixels stay transparent.
blend_mode mix;

uniform highp vec3 BLUR_COLOR;
uniform highp float STRENGTH;
uniform highp float FADE;
uniform highp vec3 CLOUD_COLOR;
uniform highp float CLOUD;

const highp float darken_strength = 0.3; // Darkness level 0.0 to 1.0
const highp float blur_radius = 2.0; // Blur radius from 0.0 to 10.0

void fragment() {
    highp vec4 color = zTexture(UV);

    // The scratch buffer already has coverage baked into its RGB.
    highp vec4 blurred = vec4(0.0);
    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            blurred += zTexture(UV + vec2(x, y) * TEXTURE_PIXEL_SIZE * blur_radius);
        }
    }
    blurred /= 9.0;
    blurred.rgb *= mix(vec3(1.0), BLUR_COLOR, darken_strength);

    highp vec4 mixed = mix(color, blurred, clamp(STRENGTH, 0.0, 1.0));
    highp vec3 rgb = mixed.rgb / max(mixed.a, 0.0001);
    rgb = mix(rgb, CLOUD_COLOR, clamp(CLOUD, 0.0, 1.0));
    COLOR = vec4(rgb, mixed.a * clamp(FADE, 0.0, 1.0));
}
